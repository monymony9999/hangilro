rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function planPath(sid) { return /databases/$(database)/documents/shared/$(sid); }
    function isMember(sid) {
      return signedIn() && exists(/databases/$(database)/documents/shared/$(sid)/members/$(request.auth.uid));
    }
    function validMeta(d) {
      return d.keys().hasOnly(['title', 'days', 'v', 'owner', 'completed'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 60
        && d.days is int && d.days >= 1 && d.days <= 60
        && (!('completed' in d) || d.completed is map);
    }
    function validBlock(d) {
      return d.keys().hasOnly(['day', 'start', 'dur', 'text'])
        && d.day is int && d.day >= 0 && d.day < 60
        && d.start is int && d.start >= 0 && d.start < 1440
        && d.dur is int && d.dur >= 5 && d.dur <= 1440
        && d.text is string && d.text.size() <= 200;
    }

    // 공유 계획: 8자리 코드를 아는 로그인 사용자만 참여(멤버 등록)할 수 있어요.
    match /shared/{sid} {
      allow read: if isMember(sid);
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid && validMeta(request.resource.data);
      allow update: if isMember(sid) && validMeta(request.resource.data)
        && request.resource.data.owner == resource.data.owner;
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;

      match /members/{uid} {
        allow create: if signedIn() && request.auth.uid == uid && exists(planPath(sid));
        allow read: if isMember(sid);
        allow delete: if signedIn() && request.auth.uid == uid;
      }
      match /blocks/{bid} {
        allow read: if isMember(sid);
        allow create, update: if isMember(sid) && validBlock(request.resource.data);
        allow delete: if isMember(sid);
      }
      match /photos/{bid} {
        allow read: if isMember(sid);
        allow create, update: if isMember(sid)
          && request.resource.data.keys().hasOnly(['data'])
          && request.resource.data.data is string
          && request.resource.data.data.size() < 400000;
        allow delete: if isMember(sid);
      }
      match /presence/{uid} {
        allow read: if isMember(sid);
        allow write: if isMember(sid) && request.auth.uid == uid;
      }
    }
  }
}
